<Application
    x:Class="StandbyMemoryManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="AccentBlue">#1686FF</Color>
            <Color x:Key="AccentGreen">#42D392</Color>
            <Color x:Key="PanelColor">#CC101826</Color>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window
    x:Class="Veltrixa.Views.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetricColumnThree.Width" Value="0" />
                        <Setter Target="MetricColumnFour.Width" Value="0" />
                        <Setter Target="MetricSecondRow.Height" Value="Auto" />
                        <Setter Target="MetricGrid.RowSpacing" Value="12" />
                        <Setter Target="AvailableCard.(Grid.Row)" Value="1" />
                        <Setter Target="AvailableCard.(Grid.Column)" Value="0" />
                        <Setter Target="StandbyCard.(Grid.Row)" Value="1" />
                        <Setter Target="StandbyCard.(Grid.Column)" Value="1" />
                        <Setter Target="SummaryRightColumn.Width" Value="0" />
                        <Setter Target="SummarySecondRow.Height" Value="Auto" />
                        <Setter Target="SummaryGrid.RowSpacing" Value="16" />
                        <Setter Target="SummarySensors.(Grid.Row)" Value="1" />
                        <Setter Target="SummarySensors.(Grid.Column)" Value="0" />
                        <Setter Target="HardwareRightColumn.Width" Value="0" />
                        <Setter Target="HardwareSecondRow.Height" Value="Auto" />
                        <Setter Target="HardwareGrid.RowSpacing" Value="16" />
                        <Setter Target="GpuCard.(Grid.Row)" Value="1" />
                        <Setter Target="GpuCard.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Padding="20,16,20,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource BrandBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Veltrixa" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderSubtitle" Text="Memoria y hardware de Windows" Style="{StaticResource LabelStyle}" />
            </StackPanel>
            <ComboBox x:Name="ThemeSelector" Grid.Column="2" Header="Tema" Width="120"
                      SelectedIndex="0" SelectionChanged="ThemeSelector_SelectionChanged"
                      AutomationProperties.Name="Apariencia de la aplicación">
                <ComboBoxItem Content="Sistema" Tag="Default" />
                <ComboBoxItem Content="Claro" Tag="Light" />
                <ComboBoxItem Content="Oscuro" Tag="Dark" />
            </ComboBox>
        </Grid>

        <TabView x:Name="MainTabs" Grid.Row="1" Margin="16,0,16,0"
                 IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                 TabWidthMode="SizeToContent" SelectionChanged="MainTabs_SelectionChanged">
            <TabViewItem Header="Resumen" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE80F;" /></TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20" Padding="8,20,8,20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tu memoria, de un vistazo" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.MemorySummary, Mode=OneWay}" Style="{StaticResource BodyStyle}" />
                        </StackPanel>

                        <Grid x:Name="MetricGrid" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="MetricColumnThree" Width="*" />
                                <ColumnDefinition x:Name="MetricColumnFour" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="MetricSecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RAM instalada" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.InstalledRam, Mode=OneWay}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Capacidad del equipo" Style="{StaticResource LabelStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SurfaceStyle}" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="En uso" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.UsedRam, Mode=OneWay}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Aplicaciones y sistema" Style="{StaticResource LabelStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AvailableCard" Grid.Column="2" Style="{StaticResource SurfaceStyle}" Padding="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Disponible" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AvailableRam, Mode=OneWay}" Style="{StaticResource MetricStyle}" Foreground="{ThemeResource TealBrush}" />
                                    <TextBlock Text="Incluye la caché standby" Style="{StaticResource LabelStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="StandbyCard" Grid.Column="3" Style="{StaticResource SurfaceStyle}" Padding="16" Background="{ThemeResource BrandSoftBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Caché standby" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Standby, Mode=OneWay}" Style="{StaticResource MetricStyle}" Foreground="{ThemeResource BrandBrush}" />
                                    <TextBlock Text="Lista para reutilizarse" Style="{StaticResource LabelStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="SummaryGrid" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition x:Name="SummaryRightColumn" Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="SummarySecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SurfaceStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Distribución de la memoria" Style="{StaticResource SectionHeadingStyle}" />
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="En uso" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.UsedRam, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}" Maximum="100" Height="6"
                                                     Foreground="{ThemeResource BrandBrush}" AutomationProperties.Name="RAM en uso" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="Disponible" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.AvailableRam, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ViewModel.AvailablePercent, Mode=OneWay}" Maximum="100" Height="6"
                                                     Foreground="{ThemeResource TealBrush}" AutomationProperties.Name="RAM disponible" />
                                    </StackPanel>
                                    <TextBlock Text="Windows reutiliza la memoria standby cuando tus aplicaciones la necesitan. No se suma a la memoria disponible: ya forma parte de ella."
                                               Style="{StaticResource BodyStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SummarySensors" Grid.Column="1" Style="{StaticResource SurfaceStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Pulso del hardware" Style="{StaticResource SectionHeadingStyle}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuLoad, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="Carga actual" Style="{StaticResource LabelStyle}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="GPU" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="Carga actual" Style="{StaticResource LabelStyle}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.SensorStatus, Mode=OneWay}" Style="{StaticResource BodyStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SurfaceStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Limpieza bajo demanda" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="Vacía la caché standby para una prueba o diagnóstico. No es necesaria como mantenimiento habitual." Style="{StaticResource BodyStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" AutomationProperties.Name="Limpieza en curso" />
                                        <Button Click="Clean_Click" Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}" Padding="16,10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE894;" FontSize="16" />
                                                <TextBlock Text="Limpiar standby" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Última limpieza" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.LastClean, Mode=OneWay}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Liberado en la última limpieza" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Released, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TealBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Hardware" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE950;" /></TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20" Padding="8,20,8,20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Conoce el estado de tu equipo" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SensorStatus, Mode=OneWay}" Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <Grid x:Name="HardwareGrid" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HardwareRightColumn" Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="HardwareSecondRow" Height="0" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource SurfaceStyle}">
                                <StackPanel Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="PROCESADOR" Style="{StaticResource LabelStyle}" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" Style="{StaticResource SectionHeadingStyle}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.CpuName, Mode=OneWay}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Temperatura" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" Style="{StaticResource MetricStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Carga" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.CpuLoad, Mode=OneWay}" Style="{StaticResource MetricStyle}" Foreground="{ThemeResource BrandBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Ventilador" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CpuFan, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="GpuCard" Grid.Column="1" Style="{StaticResource SurfaceStyle}">
                                <StackPanel Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="TARJETA GRÁFICA" Style="{StaticResource LabelStyle}" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" Style="{StaticResource SectionHeadingStyle}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.GpuName, Mode=OneWay}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Temperatura" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" Style="{StaticResource MetricStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Carga" Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" Style="{StaticResource MetricStyle}" Foreground="{ThemeResource BrandBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid RowSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Punto más caliente" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GpuHotspot, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Memoria de vídeo" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.GpuVram, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Text="Ventilador" Style="{StaticResource LabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GpuFan, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SurfaceStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Memoria y almacenamiento" Style="{StaticResource SectionHeadingStyle}" />
                                <Grid RowSpacing="12" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="RAM del sistema" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalRam, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="Disco del sistema" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.StorageInfo, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Lecturas disponibles"
                                 Message="Un guion (—) indica que el equipo no expone ese sensor; no significa cero. Las lecturas son de solo lectura." />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Procesos" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE9D9;" /></TabViewItem.IconSource>
                <Grid Padding="8,20,8,12" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Qué está usando tu memoria" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Procesos ordenados por RAM residente (Working Set). La caché standby pertenece al sistema y no se atribuye aquí a aplicaciones."
                                   Style="{StaticResource BodyStyle}" />
                    </StackPanel>
                    <TextBox x:Name="ProcessSearch" Grid.Row="1" PlaceholderText="Buscar por nombre o PID"
                             TextChanged="ProcessSearch_TextChanged" MaxWidth="420" HorizontalAlignment="Left"
                             AutomationProperties.Name="Buscar procesos por nombre o identificador" />
                    <Grid Grid.Row="2">
                        <ListView x:Name="ProcessList" ItemsSource="{x:Bind ViewModel.TopProcesses, Mode=OneWay}"
                                  SelectionMode="None" HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind ViewModel.HasProcesses, Mode=OneWay}"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                                  AutomationProperties.Name="Procesos ordenados por memoria residente">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid Padding="12" ColumnSpacing="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Proceso" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="RAM residente" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="Memoria privada" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="Estado" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="PID" Style="{StaticResource LabelStyle}" FontSize="12" />
                                                <TextBlock Text="{Binding Pid}" Style="{StaticResource LabelStyle}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding WorkingSetDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource BrandBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PrivateDisplay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380"
                                    Visibility="{x:Bind ViewModel.IsProcessListEmpty, Mode=OneWay}">
                            <ProgressRing Width="28" Height="28" IsActive="{x:Bind ViewModel.IsRefreshingProcesses, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsRefreshingProcesses, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ProcessEmptyMessage, Mode=OneWay}" Style="{StaticResource BodyStyle}"
                                       TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>
        <InfoBar Grid.Row="2" Margin="24,0,24,8" IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                 IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        <Grid Grid.Row="3" Padding="24,10,24,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.MonitoringStatus, Mode=OneWay}" Style="{StaticResource LabelStyle}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay}" Style="{StaticResource LabelStyle}" FontSize="12" />
        </Grid>
    </Grid>
</Window>

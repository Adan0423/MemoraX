<Window
    x:Class="StandbyMemoryManager.Views.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="#E40A111D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Standby Memory Manager" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Memoria, temperatura y procesos en tiempo real" Opacity="0.65" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Limpiar Standby" Click="Clean_Click" Padding="18,10" CornerRadius="12" />
        </Grid>

        <TabView x:Name="MainTabs" Grid.Row="1" Margin="18,0,18,12" IsAddTabButtonVisible="False">
            <TabViewItem Header="Resumen">
                <ScrollViewer>
                    <StackPanel Spacing="14" Padding="6,8,6,20">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#AA111C2B" CornerRadius="16" Padding="18">
                                <StackPanel><TextBlock Text="RAM total" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.TotalRam, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#AA111C2B" CornerRadius="16" Padding="18">
                                <StackPanel><TextBlock Text="En uso" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.UsedRam, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#AA111C2B" CornerRadius="16" Padding="18">
                                <StackPanel><TextBlock Text="Disponible" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.AvailableRam, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#CC0E2A4D" BorderBrush="#1686FF" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel><TextBlock Text="Standby Memory" Opacity="0.75"/><TextBlock Text="{x:Bind ViewModel.Standby, Mode=OneWay}" FontSize="25" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="{x:Bind ViewModel.StandbyPercent, Mode=OneWay}" Foreground="#65AFFF"/></StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#AA111C2B" CornerRadius="18" Padding="22">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Uso de memoria" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Standby actual" Opacity="0.62" />
                                    <TextBlock Text="{x:Bind ViewModel.Standby, Mode=OneWay}" FontSize="46" FontWeight="Bold" />
                                    <ProgressBar Value="{x:Bind ViewModel.StandbyProgress, Mode=OneWay}" Maximum="100" Height="8" />
                                    <TextBlock Text="La Standby Memory es caché reutilizable. Limpiarla no aumenta la RAM física; úsala cuando quieras liberar esa caché bajo demanda." TextWrapping="Wrap" Opacity="0.62" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Background="#AA111C2B" CornerRadius="16" Padding="18">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="GPU" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" FontSize="30" FontWeight="Bold"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="TEMP" Foreground="#1686FF" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Background="#AA111C2B" CornerRadius="16" Padding="18">
                                    <StackPanel><TextBlock Text="CPU" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="30" FontWeight="Bold"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#AA111C2B" CornerRadius="16" Padding="16"><StackPanel><TextBlock Text="Última limpieza" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.LastClean, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="#AA111C2B" CornerRadius="16" Padding="16"><StackPanel><TextBlock Text="Liberado" Opacity="0.65"/><TextBlock Text="{x:Bind ViewModel.Released, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#42D392"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Hardware">
                <ScrollViewer>
                    <StackPanel Spacing="14" Padding="6,8,6,20">
                        <TextBlock Text="Temperaturas y carga" FontSize="20" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#AA111C2B" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="40" FontWeight="Bold" />
                                    <TextBlock Text="Carga CPU" Opacity="0.62"/><TextBlock Text="{x:Bind ViewModel.CpuLoad, Mode=OneWay}" FontSize="21" />
                                    <TextBlock Text="Ventilador CPU" Opacity="0.62" Margin="0,8,0,0"/><TextBlock Text="{x:Bind ViewModel.CpuFan, Mode=OneWay}" FontSize="21" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#AA111C2B" CornerRadius="18" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                                    <TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" FontSize="40" FontWeight="Bold" />
                                    <TextBlock Text="Hotspot" Opacity="0.62"/><TextBlock Text="{x:Bind ViewModel.GpuHotspot, Mode=OneWay}" FontSize="21" />
                                    <TextBlock Text="Carga GPU" Opacity="0.62"/><TextBlock Text="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" FontSize="21" />
                                    <TextBlock Text="VRAM" Opacity="0.62"/><TextBlock Text="{x:Bind ViewModel.GpuVram, Mode=OneWay}" FontSize="21" />
                                    <TextBlock Text="Ventilador GPU" Opacity="0.62"/><TextBlock Text="{x:Bind ViewModel.GpuFan, Mode=OneWay}" FontSize="21" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <InfoBar IsOpen="True" Severity="Informational" Title="Sensores de hardware"
                                 Message="Algunos equipos o drivers no exponen todos los sensores. En esos casos se muestra —. La lectura de sensores puede requerir ejecutar como administrador." />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Procesos">
                <Grid Padding="6,8,6,18" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <InfoBar IsOpen="True" Severity="Informational" Title="Importante"
                             Message="Windows no atribuye de forma fiable la Standby List total a aplicaciones concretas. Esta vista muestra Working Set y memoria privada de los procesos para diagnóstico; no representa 'Standby por app'." />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopProcesses, Mode=OneWay}">
                        <ListView.Header>
                            <Grid Padding="10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Aplicación" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Working Set" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Privada" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Estado" FontWeight="SemiBold"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Pid}" FontSize="11" Opacity="0.55"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding WorkingSetDisplay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PrivateDisplay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="2" Background="#78111B29" Padding="18,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="Actualización: 3 s" Opacity="0.45" />
            </Grid>
        </Border>
    </Grid>
</Window>

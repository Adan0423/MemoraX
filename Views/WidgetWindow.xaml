<Window
    x:Class="Veltrixa.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Padding="6" RowSpacing="1"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Limpiar caché standby" Click="Clean_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Abrir panel" Click="Details_Click" />
                <MenuFlyoutItem Text="Abrir procesos" Click="Processes_Click" />
                <MenuFlyoutItem Text="Minimizar widget" Click="Minimize_Click" />
                <MenuFlyoutItem Text="Cerrar Veltrixa" Click="Close_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="WidgetDragRegion" RightTapped="WidgetDragRegion_RightTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource TealBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Veltrixa" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Width="23" Height="23" Padding="0" Click="Optimize_Click"
                    Background="{ThemeResource BrandSoftBrush}" BorderBrush="{ThemeResource BrandBrush}"
                    BorderThickness="1" CornerRadius="8" IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}"
                    AutomationProperties.Name="Optimizar memoria" ToolTipService.ToolTip="Optimizar memoria">
                <FontIcon Glyph="&#xE709;" FontSize="12" Foreground="{ThemeResource BrandBrush}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="4" Visibility="{x:Bind ViewModel.HasStandby, Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Standby" Style="{StaticResource LabelStyle}" FontSize="9" />
                <TextBlock Text="{x:Bind ViewModel.Standby, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StandbyPercentShort, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center" AutomationProperties.Name="Porcentaje de caché standby" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.HasCpuTemperature, Mode=OneWay}">
                <TextBlock Text="CPU" Style="{StaticResource LabelStyle}" FontSize="11" />
                <TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.HasGpuTemperature, Mode=OneWay}">
                <TextBlock Text="GPU" Style="{StaticResource LabelStyle}" FontSize="11" />
                <TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <ProgressRing Grid.Column="2" Width="14" Height="14" IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" AutomationProperties.Name="Limpieza en curso" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource LabelStyle}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>

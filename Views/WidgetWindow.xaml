<Window
    x:Class="StandbyMemoryManager.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Border BorderBrush="#2A3C54" BorderThickness="1" CornerRadius="16" Background="#EE09111E">
        <Grid x:Name="RootGrid" Padding="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Grid Grid.Row="0" Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#42D392" VerticalAlignment="Center" />
                    <TextBlock Text="MEMORAX" FontSize="11" FontWeight="Bold" CharacterSpacing="60" Opacity="0.85" Foreground="#94A3B8" />
                </StackPanel>

                <!-- Minimize and Close Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="—" Click="Minimize_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,1" FontSize="11" Opacity="0.7" Foreground="#94A3B8"/>
                    <Button Content="✕" Click="Close_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,1" FontSize="11" Opacity="0.7" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>

            <!-- Main Interactive Display -->
            <Grid Grid.Row="1" Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Standby Memory Hero Button -->
                <Button Click="Clean_Click" Background="#132035" BorderBrush="#243752" BorderThickness="1"
                        CornerRadius="14" Padding="10,8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Caché Standby" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Foreground="#CBD5E1" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2">
                            <TextBlock Text="{x:Bind ViewModel.Standby, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" />
                        </StackPanel>
                        <ProgressBar Grid.Row="2" Value="{x:Bind ViewModel.StandbyProgress, Mode=OneWay}"
                                     Maximum="100" Height="4" Margin="2,4,2,0" Foreground="#38BDF8" />
                    </Grid>
                </Button>

                <!-- Hardware Temp Badges -->
                <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                    <!-- GPU Temp -->
                    <Border Background="#162337" BorderBrush="#23354E" BorderThickness="1" CornerRadius="10" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPU 🌡️" FontSize="9" FontWeight="SemiBold" Opacity="0.65" Foreground="#94A3B8" />
                                <TextBlock Text="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="5" Height="5" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0" />
                        </Grid>
                    </Border>

                    <!-- CPU Temp -->
                    <Border Background="#162337" BorderBrush="#23354E" BorderThickness="1" CornerRadius="10" Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="CPU ⚡" FontSize="9" FontWeight="SemiBold" Opacity="0.65" Foreground="#94A3B8" />
                            <TextBlock Text="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bottom Action Navigation Button (Single Full-Width) -->
            <Button Grid.Row="2" Content="📊  Abrir MemoraX" Click="Details_Click" Background="#17263C" BorderBrush="#263A56" BorderThickness="1" CornerRadius="10" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" />
        </Grid>
    </Border>
</Window>
